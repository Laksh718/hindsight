# Hindsight needs two keys, and both have free tiers with no card required.
# Copy this file to .env and fill them in:  cp .env.example .env

# 1. The model. Google Gemini, free tier.
#    Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# 2. Web search. Tavily, 1,000 free searches a month.
#    Get a key: https://app.tavily.com
TAVILY_API_KEY=


# Optional: use a different model provider.
# Every provider below speaks the OpenAI chat-completions format, so switching
# is a config change, not a code change. Set its key, and LLM_PROVIDER if you
# have more than one key set.
#
# GROQ_API_KEY=            free tier, very fast   https://console.groq.com/keys
# ANTHROPIC_API_KEY=                              https://console.anthropic.com
# OPENAI_API_KEY=                                 https://platform.openai.com/api-keys
# OPENROUTER_API_KEY=                             https://openrouter.ai/keys
#
# LLM_PROVIDER=gemini      gemini | groq | anthropic | openai | openrouter | custom
# LLM_MODEL=               override the provider's default model
# LLM_FAST_MODEL=          model for background work (titles, claim extraction)
#
# Any other OpenAI-compatible server (Ollama, vLLM, LM Studio):
# LLM_PROVIDER=custom
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=
# LLM_MODEL=


# Optional: server settings.
# PORT=3000
# DATA_DIR=./data          where conversations and the claim ledger are stored
